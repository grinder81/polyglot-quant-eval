{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "polyglot-quant-eval result row",
  "type": "object",
  "required": ["run_id", "timestamp", "model_id", "format", "runtime", "device", "task", "language", "metric", "value", "n", "mode"],
  "properties": {
    "run_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "model_id": {"type": "string", "description": "e.g. CohereLabs/tiny-aya-global"},
    "model_revision": {"type": ["string", "null"]},
    "format": {"type": "string", "description": "bf16 | gguf-q4_k_m | mlx-4bit-g64 | awq-int4-g128 | gptq-int4-g128 | fp8 | et-8da4w | qat-int4 ..."},
    "quantizer": {"type": ["string", "null"], "description": "llama-quantize | mlx_lm.convert | llm-compressor | torchao ..."},
    "quantizer_version": {"type": ["string", "null"]},
    "calibration_set": {"type": ["string", "null"], "description": "none | en-ultrachat-512 | multi14-512 | imatrix-<name>"},
    "bits": {"type": ["number", "null"]},
    "group_size": {"type": ["integer", "null"]},
    "runtime": {"type": "string"},
    "runtime_version": {"type": ["string", "null"]},
    "backend": {"type": ["string", "null"], "description": "cuda | metal | cpu | opencl | hexagon | xnnpack | coreml"},
    "device": {"type": "string", "description": "rtx5090 | mac-m4 | iphone-17-pro | galaxy-s25 ..."},
    "os_version": {"type": ["string", "null"]},
    "task": {"type": "string"},
    "language": {"type": "string", "description": "two-letter code from configs/languages.yaml"},
    "metric": {"type": "string"},
    "value": {"type": "number"},
    "stderr": {"type": ["number", "null"]},
    "n": {"type": "integer"},
    "mode": {"type": "string", "enum": ["loglikelihood_mcq", "generation", "judge_pairwise", "human_pairwise"]},
    "fewshot": {"type": ["integer", "null"]},
    "seed": {"type": ["integer", "null"]},
    "prompt_hash": {"type": ["string", "null"]},
    "sample_set_hash": {"type": ["string", "null"], "description": "Verified sample-membership manifest hash; count alone is insufficient"},
    "scoring_contract_hash": {"type": ["string", "null"], "description": "Verified scoring contract including template, normalization, task version and decoding settings"},
    "parity_rate": {"type": ["number", "null"], "description": "desktop-vs-device greedy token agreement for this format, if measured"},
    "source_file": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
